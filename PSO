import numpy as np
import matplotlib.pyplot as plt

from sklearn.datasets import load_wine
from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)


# ============================================================
# 1. LOAD WINE DATASET
# ============================================================

data = load_wine()

X = data.data
y = data.target

feature_names = data.feature_names

print("Dataset shape:", X.shape)
print("Number of features:", X.shape[1])
print("Number of classes:", len(np.unique(y)))


# ============================================================
# 2. TRAIN-TEST SPLIT
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)


# ============================================================
# 3. FEATURE SCALING
# ============================================================

scaler = StandardScaler()

X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)


# ============================================================
# 4. BASELINE SVM
# ============================================================

print("\n==============================")
print("BASELINE SVM")
print("==============================")

baseline_svm = SVC(
    kernel="rbf",
    C=1.0,
    gamma="scale"
)

baseline_svm.fit(X_train, y_train)

baseline_prediction = baseline_svm.predict(X_test)

baseline_accuracy = accuracy_score(
    y_test,
    baseline_prediction
)

print("Baseline SVM Accuracy:",
      round(baseline_accuracy * 100, 2), "%")


# ============================================================
# 5. PSO PARAMETERS
# ============================================================

n_particles = 20
n_iterations = 30

w = 0.7
c1 = 1.5
c2 = 1.5

n_features = X_train.shape[1]


# ============================================================
# 6. PARTICLE REPRESENTATION
# ============================================================
#
# Each particle contains:
#
# 13 feature-selection values
# +
# 1 value for SVM C
# +
# 1 value for SVM gamma
#
# Total dimensions = 15
#
# Feature value:
# > 0.5 = feature selected
# <= 0.5 = feature not selected
#
# ============================================================

dimension = n_features + 2


# Initialize particles
positions = np.random.uniform(
    0,
    1,
    size=(n_particles, dimension)
)

# Initialize velocities
velocities = np.random.uniform(
    -1,
    1,
    size=(n_particles, dimension)
)


# ============================================================
# 7. DECODE PARTICLE
# ============================================================

def decode_particle(position):

    # Feature selection
    feature_mask = position[:n_features] > 0.5

    # Make sure at least one feature is selected
    if np.sum(feature_mask) == 0:

        best_feature = np.argmax(
            position[:n_features]
        )

        feature_mask[best_feature] = True

    # Convert particle values to SVM parameters
    #
    # C range approximately:
    # 2^-5 to 2^15
    #
    # Gamma range approximately:
    # 2^-15 to 2^3

    C = 2 ** (
        -5 + 20 * position[n_features]
    )

    gamma = 2 ** (
        -15 + 18 * position[n_features + 1]
    )

    return feature_mask, C, gamma


# ============================================================
# 8. FITNESS FUNCTION
# ============================================================

def fitness(position):

    feature_mask, C, gamma = decode_particle(
        position
    )

    selected_features = np.sum(
        feature_mask
    )

    X_selected = X_train[
        :,
        feature_mask
    ]

    # SVM model
    model = SVC(
        C=C,
        gamma=gamma,
        kernel="rbf"
    )

    # 3-fold cross validation
    scores = cross_val_score(
        model,
        X_selected,
        y_train,
        cv=3,
        scoring="accuracy"
    )

    accuracy = scores.mean()

    # Feature selection penalty
    feature_ratio = (
        selected_features /
        n_features
    )

    # Fitness function
    #
    # Higher accuracy = better
    # Fewer features = better
    #
    fitness_value = (
        accuracy -
        0.01 * feature_ratio
    )

    return fitness_value


# ============================================================
# 9. INITIALIZE PERSONAL BEST
# ============================================================

pbest_positions = positions.copy()

pbest_scores = np.array([
    fitness(position)
    for position in positions
])


# ============================================================
# 10. INITIALIZE GLOBAL BEST
# ============================================================

best_index = np.argmax(
    pbest_scores
)

gbest_position = (
    pbest_positions[best_index].copy()
)

gbest_score = (
    pbest_scores[best_index]
)


# ============================================================
# 11. PSO OPTIMIZATION
# ============================================================

convergence = []


print("\n==============================")
print("STARTING PSO OPTIMIZATION")
print("==============================")


for iteration in range(n_iterations):

    for i in range(n_particles):

        # Random values
        r1 = np.random.random(
            dimension
        )

        r2 = np.random.random(
            dimension
        )

        # ------------------------------------
        # Velocity update
        # ------------------------------------

        velocities[i] = (
            w * velocities[i]
            +
            c1 * r1 *
            (
                pbest_positions[i]
                -
                positions[i]
            )
            +
            c2 * r2 *
            (
                gbest_position
                -
                positions[i]
            )
        )

        # ------------------------------------
        # Position update
        # ------------------------------------

        positions[i] = (
            positions[i]
            +
            velocities[i]
        )

        # Keep position between 0 and 1
        positions[i] = np.clip(
            positions[i],
            0,
            1
        )

        # ------------------------------------
        # Calculate fitness
        # ------------------------------------

        current_score = fitness(
            positions[i]
        )

        # ------------------------------------
        # Update personal best
        # ------------------------------------

        if current_score > pbest_scores[i]:

            pbest_scores[i] = (
                current_score
            )

            pbest_positions[i] = (
                positions[i].copy()
            )

        # ------------------------------------
        # Update global best
        # ------------------------------------

        if current_score > gbest_score:

            gbest_score = (
                current_score
            )

            gbest_position = (
                positions[i].copy()
            )

    convergence.append(
        gbest_score
    )

    print(
        f"Iteration {iteration + 1:02d}/{n_iterations} "
        f"| Best Fitness = {gbest_score:.5f}"
    )


# ============================================================
# 12. GET BEST SOLUTION
# ============================================================

best_features, best_C, best_gamma = (
    decode_particle(gbest_position)
)


selected_indices = np.where(
    best_features
)[0]


print("\n==============================")
print("BEST PSO SOLUTION")
print("==============================")

print(
    "Selected feature indices:",
    selected_indices
)

print(
    "Number of selected features:",
    len(selected_indices)
)

print("\nSelected feature names:")

for index in selected_indices:

    print(
        "-",
        feature_names[index]
    )

print(
    "\nBest C:",
    best_C
)

print(
    "Best Gamma:",
    best_gamma
)

print(
    "Best fitness:",
    gbest_score
)


# ============================================================
# 13. TRAIN FINAL PSO-SVM
# ============================================================

final_svm = SVC(
    C=best_C,
    gamma=best_gamma,
    kernel="rbf"
)

final_svm.fit(
    X_train[:, best_features],
    y_train
)


# ============================================================
# 14. TEST FINAL MODEL
# ============================================================

y_pred = final_svm.predict(
    X_test[:, best_features]
)


# ============================================================
# 15. PERFORMANCE METRICS
# ============================================================

accuracy = accuracy_score(
    y_test,
    y_pred
)

precision = precision_score(
    y_test,
    y_pred,
    average="weighted"
)

recall = recall_score(
    y_test,
    y_pred,
    average="weighted"
)

f1 = f1_score(
    y_test,
    y_pred,
    average="weighted"
)


print("\n==============================")
print("FINAL PSO-SVM RESULTS")
print("==============================")

print(
    f"Accuracy  : {accuracy * 100:.2f}%"
)

print(
    f"Precision : {precision * 100:.2f}%"
)

print(
    f"Recall    : {recall * 100:.2f}%"
)

print(
    f"F1 Score  : {f1 * 100:.2f}%"
)


# ============================================================
# 16. CLASSIFICATION REPORT
# ============================================================

print("\nClassification Report:")

print(
    classification_report(
        y_test,
        y_pred,
        target_names=data.target_names
    )
)


# ============================================================
# 17. CONFUSION MATRIX
# ============================================================

cm = confusion_matrix(
    y_test,
    y_pred
)

print("\nConfusion Matrix:")

print(cm)


# ============================================================
# 18. CONVERGENCE GRAPH
# ============================================================

plt.figure(
    figsize=(8, 5)
)

plt.plot(
    range(1, n_iterations + 1),
    convergence,
    marker="o"
)

plt.xlabel(
    "Iteration"
)

plt.ylabel(
    "Best Fitness"
)

plt.title(
    "PSO-SVM Convergence"
)

plt.grid(True)

plt.tight_layout()

plt.show()


# ============================================================
# 19. COMPARISON
# ============================================================

print("\n==============================")
print("COMPARISON")
print("==============================")

print(
    f"Normal SVM Accuracy : "
    f"{baseline_accuracy * 100:.2f}%"
)

print(
    f"PSO-SVM Accuracy    : "
    f"{accuracy * 100:.2f}%"
)

print(
    f"Original Features   : "
    f"{n_features}"
)

print(
    f"Selected Features   : "
    f"{len(selected_indices)}"
)
